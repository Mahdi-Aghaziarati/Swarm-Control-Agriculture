<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>config_dialog</class>
 <widget class="QDialog" name="config_dialog">
  <property name="styleSheet">
   <string notr="true">/* Technic / Midnight Command. Qt 5 QSS, no assets or behavioural properties.
   Light data surfaces deliberately retain dark text: model status brushes include
   saturated yellow, green, cyan, white and red. Never override item backgrounds. */
QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #152237, stop:0.5 #0e192a, stop:1 #0a1321);
}
QWidget {
    font-family: "Segoe UI", "Tahoma", sans-serif;
    font-size: 12px;
    color: #dbe6f3;
}
QWidget#centralwidget { background: transparent; }
QLabel, QCheckBox { background: transparent; }
QLabel { color: #9fb3ca; }
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #263950, stop:1 #1b2b40);
    color: #dce8f5;
    border: 1px solid #3a506b;
    border-top-color: #4c6380;
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: 600;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #304b66, stop:1 #233c55);
    border-color: #4d9baa; color: #ffffff;
}
QPushButton:pressed { background: #13273c; border-color: #54d7df; }
QPushButton:focus { border-color: #75e6ef; }
QPushButton:default { border-color: #61d7e2; }
/* Filled primary: preparation check. */
QPushButton#check_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #188b9f, stop:1 #126276);
    color: #ffffff; border-color: #36a9b8; border-top-color: #66c9d3;
}
QPushButton#check_button:hover { background: #1b94a5; border-color: #85e3e8; }
QPushButton#check_button:pressed { background: #105265; }
/* Flight actions: muted emerald, not an indication of readiness. */
QPushButton#start_button, QPushButton#takeoff_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #226756, stop:1 #184b42);
    color: #defbf0; border-color: #378a73; border-top-color: #56a88e;
}
QPushButton#start_button:hover, QPushButton#takeoff_button:hover {
    background: #287e66; border-color: #74cfaa;
}
QPushButton#start_button:pressed, QPushButton#takeoff_button:pressed { background: #133f36; }
QPushButton#pause_button, QPushButton#flip_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #493c26, stop:1 #332e24);
    color: #f3d59c; border-color: #7a653f; border-top-color: #9a7d4d;
}
QPushButton#pause_button:hover, QPushButton#flip_button:hover {
    background: #59482b; border-color: #c3a164;
}
QPushButton#pause_button:pressed, QPushButton#flip_button:pressed { background: #2c261e; }
QPushButton#land_selected_button { color: #b7deec; border-color: #4a7187; }
QPushButton#land_all_button, QPushButton#disarm_all_button,
QPushButton#disarm_selected_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #442c3a, stop:1 #302333);
    color: #f3b6c1; border-color: #7c485c; border-top-color: #9b5b6e;
}
QPushButton#land_all_button:hover, QPushButton#disarm_all_button:hover,
QPushButton#disarm_selected_button:hover { background: #593244; border-color: #c47b8e; }
QPushButton#land_all_button:pressed, QPushButton#disarm_all_button:pressed,
QPushButton#disarm_selected_button:pressed { background: #291b25; }
/* Emergency remains distinct. Command scope and confirmation logic unchanged. */
QPushButton#emergency_land_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #c23b50, stop:1 #94263d);
    color: #ffffff; border-color: #e06a7b; border-top-color: #f18b96;
    font-weight: 700;
}
QPushButton#emergency_land_button:hover { background: #d1475c; border-color: #ffb0bb; }
QPushButton#emergency_land_button:pressed { background: #782236; }
/* ID specificity is required so disabled operational buttons stay subdued. */
QPushButton:disabled, QPushButton#check_button:disabled,
QPushButton#start_button:disabled, QPushButton#takeoff_button:disabled,
QPushButton#pause_button:disabled, QPushButton#flip_button:disabled,
QPushButton#land_selected_button:disabled, QPushButton#land_all_button:disabled,
QPushButton#disarm_all_button:disabled, QPushButton#disarm_selected_button:disabled,
QPushButton#emergency_land_button:disabled {
    background: #182337; color: #65778d;
    border-color: #2b3b50; border-top-color: #2b3b50;
}
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #0c1727; color: #e4eef9;
    border: 1px solid #3a526c; border-radius: 5px;
    padding: 4px; selection-background-color: #236d87; selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #54d1dc; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #172132; color: #65778d; border-color: #2b3b50;
}
QComboBox QAbstractItemView {
    background: #1a2b41; color: #e4eef9; border: 1px solid #44617d;
    selection-background-color: #25506c; selection-color: #ffffff;
}
QCheckBox { spacing: 5px; color: #b8c9dc; }
QCheckBox:disabled { color: #65778d; }
/* Do not style ::item backgrounds/hover: retain original diagnostic brushes.
   This also reaches the CopterTableWidget created at runtime. */
QTableView, QTreeView, QListView {
    background: #edf2f7; alternate-background-color: #e6edf5; color: #17283b;
    border: 1px solid #3c617c; border-top: 2px solid #36acbb;
    border-radius: 5px; gridline-color: #c6d2e0;
    selection-background-color: #b8dce9; selection-color: #102d43;
}
QTableView QLineEdit, QTreeView QLineEdit {
    background: #ffffff; color: #17283b; border-color: #2492a5;
    selection-background-color: #b8dce9; selection-color: #102d43;
}
QHeaderView { background: #182c43; }
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #233d56, stop:1 #172c43);
    color: #d9edf7; font-weight: 600;
    padding: 6px 5px; border: none;
    border-right: 1px solid #35516c; border-bottom: 1px solid #3d778b;
}
QHeaderView::section:hover { background: #2b506a; color: #ffffff; }
QTableCornerButton::section { background: #1b324b; border: 1px solid #35516c; }
QMenuBar {
    background: #0a1423; color: #b9cde3;
    border-bottom: 1px solid #2f566c; padding: 3px;
}
QMenuBar::item { background: transparent; padding: 6px 12px; border-radius: 4px; }
QMenuBar::item:selected { background: #203d55; color: #8aebf0; }
QMenuBar::item:pressed { background: #2b526b; color: #ffffff; }
QMenu {
    background: #17283d; color: #dbe6f3;
    border: 1px solid #44617d; padding: 4px;
}
QMenu::item { padding: 6px 24px; border-radius: 3px; }
QMenu::item:selected { background: #28516a; color: #ffffff; }
QMenu::item:disabled { color: #65778d; }
QMenu::separator { height: 1px; background: #354c65; margin: 5px 8px; }
QStatusBar { background: #0a1423; color: #9fb7cf; border-top: 1px solid #2b455e; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #a7c0d8; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #344b64; }
QToolTip { background: #213951; color: #f0f7ff; border: 1px solid #54869b; padding: 6px; }
</string>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>600</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Config Editor</string>
  </property>
